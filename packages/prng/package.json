{
  "name": "@anomnomnomaly/prng",
  "version": "0.0.1",
  "description": "Seeded PRNG engines: xoshiro256**, mulberry32, squirrel3",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
