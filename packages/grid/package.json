{
  "name": "@anomnomnomaly/grid",
  "version": "0.1.0",
  "description": "Tile-grid generation: room placement, BSP partitioning, cellular automata, regions, corridors",
  "license": "MIT",
  "author": "Alexis Hope (https://alexishope.dev/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofhope/-anomnomnomaly.git",
    "directory": "packages/grid"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsc -p tsconfig.build.json --watch"
  },
  "dependencies": {
    "@anomnomnomaly/prng": "^0.1.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
